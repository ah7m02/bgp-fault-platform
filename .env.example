# Copy this file to .env and fill in the real values. .env is read at startup
# by python-dotenv (load_dotenv) and should never be committed.

# --- Anthropic API ---
# Used for AI scenario generation (POST /ai/generate-scenario).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Router management IPs (SSH-reachable addresses, one per router) ---
ROUTER_R1_IP=192.168.0.241
ROUTER_R2_IP=192.168.0.242
ROUTER_R3_IP=192.168.0.243
ROUTER_R4_IP=192.168.0.244
ROUTER_R5_IP=192.168.0.245

# --- Router login credentials (shared across all five routers) ---
ROUTER_USERNAME=admin
ROUTER_PASSWORD=changeme
# Enable secret. Optional: if omitted, ROUTER_PASSWORD is used.
ROUTER_SECRET=changeme
